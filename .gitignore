# =========================================================================
# STM32 Toolchains and Build Outputs
# =========================================================================
# Exclude the entire build output directories (GCC/Eclipse/STM32CubeIDE)
Debug/
Release/
build/

# Compiler generated artifacts (in case they land in the root)
*.o
*.d
*.su
*.elf
*.bin
*.hex
*.map
*.list

# =========================================================================
# STM32CubeIDE / Eclipse / CubeMX Artifacts
# =========================================================================
# Ignore local Eclipse settings and indexers
.metadata/
.settings/
.scfg/

# Ignore log files generated by CubeMX or the IDE
*.log
.mxproject

# DO NOT IGNORE: *.ioc (Keep your STM32CubeMX configuration file!)

# =========================================================================
# Keil uVision (If using Keil instead of STM32CubeIDE)
# =========================================================================
*.uvguix.*
*.uv2.bak
*.pjt.bak
*.Txt
# ...but never ignore the build/CI files that happen to end in .txt
!CMakeLists.txt
!**/CMakeLists.txt
!ci/*.txt
*.lst
*.htm
*.dep
*.lnp
*.sct
*.axf
Listings/
Objects/

# =========================================================================
# IAR Embedded Workbench (If using IAR)
# =========================================================================
*.ewt
*.ewd
*.dep
Backup of*/
settings/

# =========================================================================
# Operating System & General IDE Files
# =========================================================================
# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code settings (if you use it for editing or debugging)
.vscode/

